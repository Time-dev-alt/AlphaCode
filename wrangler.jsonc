{
  // Workers Static Assets deployment of the client-side build.
  // The recommended path is Cloudflare **Pages** + Git (see README); this file
  // lets `wrangler deploy` publish the same dist/ as a Worker with assets only.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alphacode",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
