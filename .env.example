# ─────────────────────────────────────────────────────────────────────────────
# AlphaCode — environment template
#
# Copy to .env (gitignored) for local runs, or paste the same keys into
# Cloudflare → Workers/Containers → Settings → Variables & Secrets.
# NEVER commit real keys. Everything here is optional: with zero keys the
# platform still works — guests and signed-in users fall back to kilo/auto.
# ─────────────────────────────────────────────────────────────────────────────

# ── server ───────────────────────────────────────────────────────────────────
PORT=3000
ALPHACODE_HOST=0.0.0.0
ALPHACODE_URL=https://alphacode.example.com
# 32+ random chars. If unset, one is generated into data/secret.key (0600).
# ALPHACODE_SECRET=
ALPHACODE_DATA_DIR=data
ALPHACODE_ALLOW_REGISTRATION=true
# ALPHACODE_MOCK=1        # offline demo: deterministic "demo" provider, no keys

# ── limits / product rules ───────────────────────────────────────────────────
ALPHACODE_DAILY_REQUESTS=40        # signed-in quota per UTC day
ALPHACODE_GUEST_TURNS_PER_HOUR=30  # per-IP guest guard
KILO_MODEL=kilo-auto/free          # guest + fallback model (free, no key)

# ── provider keys (server-side; users never see them) ────────────────────────
# Chain for signed-in users: openrouter → opencode → google → kilo (fallback).
OPENROUTER_API_KEY=
OPENCODE_API_KEY=                  # empty = public anonymous free tier
GOOGLE_AI_STUDIO_API_KEY=
KILO_API_KEY=                      # empty = anonymous :free tier

# ── deployment targets (instance-level; users can add their own in Settings) ─
CLOUDFLARE_API_TOKEN=              # Pages:Edit  (+ Account:Read for account id)
CLOUDFLARE_ACCOUNT_ID=
NETLIFY_AUTH_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ── the platform's own Cloudflare deploy (scripts/deploy-cloudflare.mjs) ─────
ALPHACODE_WORKER_NAME=alphacode
# HTTPS URL of the Node runtime the Worker proxies /api/* to.
ALPHACODE_ORIGIN=

# ── security / runtime ───────────────────────────────────────────────────────
ALPHACODE_SESSION_DAYS=30
ALPHACODE_MAX_BODY=12582912
ALPHACODE_TRUST_PROXY=true
ALPHACODE_FRAME_ANCESTORS=*        # sandboxed preview embedding
ALPHACODE_SHELL=/bin/bash
ALPHACODE_MAX_ITERATIONS=48
ALPHACODE_CONTEXT_WINDOW=200000
ALPHACODE_COMPACT_AT=0.86
