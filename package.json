{
  "name": "alphacode",
  "version": "10.0.0",
  "private": true,
  "type": "module",
  "description": "AlphaCode \u2014 an AI app builder and coding agent that runs entirely in your browser: real Node + npm, CPython, a shell, SQLite, MCP and deploys, all in the tab.",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node scripts/dev-pages.mjs",
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev-pages.mjs",
    "build": "node scripts/build-pages.mjs",
    "build:obfuscate": "node scripts/build-pages.mjs --obfuscate",
    "build:server": "node scripts/build.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.mjs\"",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke.mjs",
    "pty:build": "bash scripts/build-pty.sh",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "edge:config": "node scripts/render-edge-config.mjs",
    "start:server": "node --disable-warning=ExperimentalWarning src/server.mjs",
    "vendor:nodepod": "node scripts/vendor-nodepod.mjs",
    "deploy:worker": "npm run build && wrangler deploy",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler-dry"
  },
  "keywords": [
    "coding-agent",
    "harness",
    "cloudflare",
    "vercel",
    "netlify"
  ],
  "devDependencies": {
    "javascript-obfuscator": "^4.2.2",
    "jsdom": "^30.1.3",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@webcontainer/api": "^1.5.1",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "sql.js": "^1.15.2"
  }
}
